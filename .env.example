APP_NAME=HeySentinel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=heysentinel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=heysentinel_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@heysentinel.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_PORT=80
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# === HeySentinel: External services ===
WEBSHARE_API_TOKEN=
WEBSHARE_PROXY_LIST_URL=https://proxy.webshare.io/api/v2/proxy/list/?mode=direct
WEBSHARE_MAX_PROXIES=10

STORELEADS_API_KEY=
STORELEADS_BASE_URL=https://storeleads.app/json/api

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CLASSIFIER=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_DEEP=claude-sonnet-4-6

SCRAPING_DEFAULT_APP_LIMIT=300
SCRAPING_CONCURRENT_JOBS=5
SCRAPING_JITTER_MIN_MS=200
SCRAPING_JITTER_MAX_MS=800

AI_BATCH_SIZE=50
AI_DISPATCH_CRON_MINUTES=30
AI_POLL_CRON_MINUTES=10
